            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only'}
VAR_GLOBAL
	temperature		: INT;		 	(*Sensor: current temperature of the water*)
	soaplevel		: INT; 			(*Sensor: current soap level*)
	waterlevel		: INT;			(*Sensor: current water level*)
	prog_number		: INT;			(*Input: program selected by the user*)
	temp_number		: INT; 			(*Input: temperature selected by the user*)
	run				: BOOL;			(*Input: if TRUE the washing machine works*)
	fillsoap		: BOOL; 		(*Input: if TRUE the soap tray is full*)
	bulls_eye_open	: BOOL := TRUE;	(*Input: if TRUE the door is open*)

	hot				: BOOL;			(*Actuator: if TRUE the resistor turns on*)
	motor_on		: BOOL;			(*Actuator: if TRUE the basket motor is turned on*)
	bulls_eye_lock	: BOOL;			(*Actuator: if TRUE the Door is locked*)
	emptysoap		: BOOL;			(*Actuator: if TRUE the soap tray is emptied*)
	fillwater		: BOOL;			(*Actuator: if TRUE the water is added*)
	emptywater		: BOOL;			(*Actuator: if TRUE the water is drained*)

	heat_alarm		: BOOL; 		(*Visualization: if TRUE alerts the user of the resistor fault*)
	water_in_alarm	: BOOL;			(*Visualization: if TRUE alerts the user of the water intake valve fault*)
	water_out_alarm	: BOOL; 		(*Visualization: if TRUE alerts the user of the water drain valve fault*)
	soap_alarm		: BOOL;			(*Visualization: if TRUE there is no soap*)
	prog_error		: BOOL;			(*Visualization: if TRUE the program selected is wrong*)
	temp_error		: BOOL;			(*Visualization: if TRUE the temperature selected is wrong*)
	rinse			: BOOL; 		(*Visualization: if TRUE the rinsing operation is going on*)
	prewash			: BOOL; 		(*Visualization: if TRUE the prewashing operation is going on*)
	wash			: BOOL; 		(*Visualization: if TRUE the washing operation is going on*)

	motor			: INT;			(*Only for simulation: angular position of the basket*)
	heat_fail		: BOOL;			(*Only for simulation: if TRUE the resistor cannot turn on*)
	water_in_fail	: BOOL;			(*Only for simulation: if TRUE the water intake valve is faulty*)
	water_out_fail	: BOOL;			(*Only for simulation: if TRUE the water drain valve is faulty*)
END_VAR</Single>
